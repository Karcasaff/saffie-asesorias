/********************************************************* TOLTIP  WS */
/* Tooltip container */
.tooltip_ws {
  position: relative;
  display: inline-block;
 /* border-bottom: 1px dotted black;  If you want dots under the hoverable text*/
}

/* Tooltip text */
.tooltip_ws .tooltiptext_ws {
  
  visibility: visible;
  /*antes visibility: hidden;*/
  width: 160px;
  background-color: #fff;  /************ <------ CAMBIAR AQUI   */
  color: #000;
  text-align: center;
  padding: 5px 0;
  border-radius: 10px;
  border-color: #fff;
  border: 0px solid;

  /* Position the tooltip text */
  position: absolute;
  z-index: 1;
  bottom: 0%;
  left: 50%;
  margin-left: -200px;

  /* Fade in tooltip */
  opacity: 1;
  
  /*antes opacity: 0; */
  transition: opacity 15s;
  
  -webkit-box-shadow: 10px 10px 5px -8px rgba(161,161,161,1);
-moz-box-shadow: 10px 10px 5px -8px rgba(161,161,161,1);
box-shadow: 10px 10px 5px -8px rgba(161,161,161,1);
}

/* Tooltip arrow */
.tooltip_ws .tooltiptext_ws::after {
  content: "";
  position: absolute;
  /*top: 100%;
  left: 50%;  vertical*/
 
 /*horizontal derecho*/ 
  top: 50%;
  left: 100%;
  
  
  margin-left: -5px;
  border-width: 5px;
  border-style: solid;
  border-color: #fff transparent transparent transparent;
  

  
}

/* Show the tooltip text when you mouse over the tooltip container */
.tooltip_ws:hover .tooltiptext_ws {
  
  visibility: visible;
  opacity: 1;
  
  
    /* visibility: hidden;
  opacity: 0;
   transition: opacity 0.3s;*/
  
  
}

/****************************************************************************/


